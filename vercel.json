{
  "redirects": [
    { "source": "/about-us", "destination": "/about", "statusCode": 301 },
    { "source": "/about-koveleplumbing", "destination": "/about", "statusCode": 301 },
    { "source": "/gas-plumber-melbourne", "destination": "/gas-hot-water", "statusCode": 301 },
    { "source": "/blocked-drain-repair-melbourne", "destination": "/blocked-drains", "statusCode": 301 },
    { "source": "/roof-plumber-melbourne", "destination": "/roof-plumbing", "statusCode": 301 },
    { "source": "/general-plumbing-melbourne", "destination": "/general-plumbing", "statusCode": 301 },
    { "source": "/melbourne-bathroom-renovations", "destination": "/bathroom-renovations", "statusCode": 301 },
    { "source": "/areas-we-service", "destination": "/services", "statusCode": 301 },
    { "source": "/careers", "destination": "/about", "statusCode": 301 },
    { "source": "/carbon-monoxide-testing", "destination": "/gas-hot-water", "statusCode": 301 },
    { "source": "/bathroom-renovation-tips", "destination": "/blog", "statusCode": 301 },
    { "source": "/fixing-a-blocked-drain", "destination": "/blog", "statusCode": 301 },
